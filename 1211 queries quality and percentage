-- LeetCode 1211: Queries Quality and Percentage
-- Per query_name: quality = avg(rating/position), and
-- poor_query_percentage = % of rows with rating < 3. Both rounded to 2dp.

SELECT
    query_name,
    ROUND(AVG(rating / position), 2) AS quality,
    ROUND(
        SUM(CASE WHEN rating < 3 THEN 1 ELSE 0 END)
        * 100.0 / COUNT(*),
        2
    ) AS poor_query_percentage
FROM Queries
GROUP BY query_name;
