-- LeetCode 1731: The Number of Employees Which Report to Each Employee
-- Self-join: for each manager, count direct reports and average their age.
-- INNER JOIN naturally excludes managers with zero reports.

SELECT
    m.employee_id,
    m.name,
    COUNT(e.employee_id) AS reports_count,
    ROUND(AVG(e.age), 0) AS average_age
FROM Employees m
JOIN Employees e
    ON m.employee_id = e.reports_to
GROUP BY
    m.employee_id,
    m.name
ORDER BY m.employee_id;
